
use('clinic');


async function runTask2() {
  const labPassword = process.env.CLINIC_LAB_PASSWORD || '<password>';
  if (labPassword === '<password>') {
    throw new Error('Set CLINIC_LAB_PASSWORD to your throwaway lab password before running.');
  }

  async function record(label, operation, allowDenied = false) {
    let entry;
    try {
      entry = { label, status: 'allowed', result: await operation() };
    } catch (error) {
      entry = {
        label,
        status: 'denied',
        error: {
          name: error.name,
          code: error.code,
          codeName: error.codeName,
          message: error.message.split('\n')[0]
        }
      };
      print('__CLINIC_TASK2__ ' + EJSON.stringify(entry, { relaxed: true }));
      if (!allowDenied || error.code !== 13) throw error;
      return entry;
    }
    print('__CLINIC_TASK2__ ' + EJSON.stringify(entry, { relaxed: true }));
    return entry;
  }

  function userURI(user, authSource = 'clinic') {
    return 'mongodb://' + encodeURIComponent(user) + ':' + encodeURIComponent(labPassword) +
      '@localhost:27019/clinic?authSource=' + authSource + '&serverSelectionTimeoutMS=5000';
  }

  const clinicDB = await connect(userURI('labAdmin', 'admin'));

  const collectionInfo = await record('INITIAL_COLLECTIONS', () => clinicDB.getCollectionInfos());
  for (const collection of collectionInfo.result) {
    if (['users', 'appointments'].includes(collection.name) && collection.options.validator) {
      throw new Error('Task 2 expects collections without validators; review the existing schema first.');
    }
  }

  const unrelated = await record('UNRELATED_DOCUMENT_COUNTS', async () => ({
    users: await clinicDB.users.countDocuments({
      $nor: [{ name: 'Matrix Test', email: 'matrix@example.com' }]
    }),
    appointments: await clinicDB.appointments.countDocuments({ reason: { $ne: 'matrix test' } })
  }));
  if (unrelated.result.users || unrelated.result.appointments) {
    throw new Error('Review unrelated clinic documents before resetting the Task 2 fixtures.');
  }

  async function ensureCollection(name) {
    if (collectionInfo.result.some(collection => collection.name === name)) {
      return { skipped: true, reason: 'Collection already exists.' };
    }
    return clinicDB.createCollection(name);
  }
  await record('CREATE_USERS', () => ensureCollection('users'));
  await record('CREATE_APPOINTMENTS', () => ensureCollection('appointments'));

  await record('RESET_MATRIX_USERS', () => clinicDB.users.deleteMany({
    name: 'Matrix Test', email: 'matrix@example.com'
  }));
  await record('RESET_MATRIX_APPOINTMENTS', () => clinicDB.appointments.deleteMany({ reason: 'matrix test' }));

  await record('INSERT_MATRIX_USER', () => clinicDB.users.insertOne({
    name: 'Matrix Test',
    email: 'matrix@example.com',
    role: 'admin',
    active: true
  }));

  await record('CREATE_FRONTDESK', async () => {
    const definition = {
      privileges: [
        { resource: { db: 'clinic', collection: 'users' }, actions: ['find', 'insert', 'update'] },
        { resource: { db: 'clinic', collection: 'appointments' }, actions: ['find', 'insert', 'update'] }
      ],
      roles: []
    };
    if (await clinicDB.getRole('frontdesk')) {
      return clinicDB.updateRole('frontdesk', definition);
    }
    return clinicDB.createRole({ role: 'frontdesk', ...definition });
  });

  await record('INSPECT_FRONTDESK', () => clinicDB.getRole('frontdesk', { showPrivileges: true }));

  async function saveUser(user, role) {
    const definition = {
      pwd: labPassword,
      roles: [{ role, db: 'clinic' }]
    };
    if (await clinicDB.getUser(user)) return clinicDB.updateUser(user, definition);
    return clinicDB.createUser({ user, ...definition });
  }
  await record('CREATE_APP', () => saveUser('clinicApp', 'readWrite'));
  await record('CREATE_AUDITOR', () => saveUser('auditor', 'read'));
  await record('CREATE_RECEPTION', () => saveUser('reception', 'frontdesk'));

  await record('INITIAL_USERS', () => clinicDB.getUsers());


  async function insertMatrixAppointment(database) {
    return database.appointments.insertOne({
      doctorId: new ObjectId(),
      patientId: new ObjectId(),
      start: new Date(),
      durationMin: 15,
      reason: 'matrix test',
      status: 'scheduled',
      fee: 0
    });
  }

  async function runSixOperations(label, database) {
    await record(label + '_A', () => database.users.findOne({
      name: 'Matrix Test', email: 'matrix@example.com'
    }), true);

    await record(label + '_B', () => insertMatrixAppointment(database), true);

    await record(label + '_C', () => database.users.updateOne(
      { name: 'Matrix Test', email: 'matrix@example.com' },
      { $set: { phone: '555-0400' } }
    ), true);

    await record(label + '_D', () => database.appointments.deleteOne({ reason: 'matrix test' }), true);

    await record(label + '_E', () => database.users.createIndex({ email: 1 }, { unique: false }), true);

    await record(label + '_F', async () => (await database.getCollectionNames()).sort(), true);
  }

  for (const profile of [
    { label: 'APP', connection: 'lab-app', user: 'clinicApp', authSource: 'clinic' },
    { label: 'AUDITOR', connection: 'lab-auditor', user: 'auditor', authSource: 'clinic' },
    { label: 'RECEPTION', connection: 'lab-reception', user: 'reception', authSource: 'clinic' },
    { label: 'ADMIN', connection: 'lab-admin', user: 'labAdmin', authSource: 'admin' }
  ]) {
    await record('PREPARE_' + profile.label, async () => {
      const phoneReset = await clinicDB.users.updateOne(
        { name: 'Matrix Test', email: 'matrix@example.com' },
        { $unset: { phone: '' } }
      );
      const indexes = await clinicDB.users.getIndexes();
      const emailIndexReset = indexes.some(index => index.name === 'email_1')
        ? await clinicDB.users.dropIndex('email_1')
        : null;
      return { phoneReset, emailIndexReset };
    });

    const testDB = await connect(userURI(profile.user, profile.authSource));
    await record('CONNECTION_' + profile.label, () => testDB.runCommand({ connectionStatus: 1 }));
    await runSixOperations(profile.label, testDB);
  }


  const receptionDB = await connect(userURI('reception'));
  await record('RECEPTION_AUTHORIZED_NAMES', () => receptionDB.runCommand({
    listCollections: 1,
    nameOnly: true,
    authorizedCollections: true
  }));

  await record('CLEANUP_MATRIX_APPOINTMENTS', () => clinicDB.appointments.deleteMany({ reason: 'matrix test' }));

  await record('REVOKE_APP_READWRITE', () => clinicDB.revokeRolesFromUser('clinicApp', [
    { role: 'readWrite', db: 'clinic' }
  ]));

  const appWithoutRoles = await connect(userURI('clinicApp'));
  await record('APP_WITHOUT_ROLES_STATUS', () => appWithoutRoles.runCommand({ connectionStatus: 1 }));
  await record('APP_WITHOUT_ROLES_B', () => insertMatrixAppointment(appWithoutRoles), true);

  await record('GRANT_APP_READ', () => clinicDB.grantRolesToUser('clinicApp', [
    { role: 'read', db: 'clinic' }
  ]));

  const appReadOnly = await connect(userURI('clinicApp'));
  await record('APP_READ_STATUS', () => appReadOnly.runCommand({ connectionStatus: 1 }));
  await record('APP_READ_A', () => appReadOnly.users.findOne({
    name: 'Matrix Test', email: 'matrix@example.com'
  }), true);
  await record('APP_READ_B', () => insertMatrixAppointment(appReadOnly), true);

  await record('FINAL_USERS', () => clinicDB.getUsers());
  await record('FINAL_COUNTS', async () => ({
    users: await clinicDB.users.countDocuments({}),
    appointments: await clinicDB.appointments.countDocuments({})
  }));
}

runTask2();



